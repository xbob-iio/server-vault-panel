# Скопируйте в .env и при необходимости измените.

# Адрес и порт. По умолчанию панель слушает только localhost —
# для доступа извне ставьте её за reverse-proxy с HTTPS (см. README).
HOST=127.0.0.1
PORT=3000

# Папка с базой данных и ключом приложения (не коммитьте её!)
DATA_DIR=data

# Если панель стоит за nginx/Caddy на этой же машине: TRUST_PROXY=loopback
TRUST_PROXY=false

# true — cookie только по HTTPS. Обязательно включите при работе через интернет.
SECURE_COOKIES=false

# Автовыход при бездействии (минуты) и максимальная длина сессии (часы)
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Как часто проверять доступность серверов (секунды)
MONITOR_INTERVAL_SECONDS=60
