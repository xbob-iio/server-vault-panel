{
	# Сертификат продлевается автоматически (за ~30 дней до истечения).
	admin off
	# Порт 80 наружу не публикуется — редирект с HTTP не нужен.
	auto_https disable_redirects
}

{$DOMAIN} {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	encode zstd gzip

	header {
		-Server
		-Via
	}

	reverse_proxy app:3000

	log {
		output stdout
		format console
	}
}
