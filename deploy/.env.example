# Скопируйте в deploy/.env на сервере и выполните: chmod 600 deploy/.env
# Этот файл с реальным токеном НЕЛЬЗЯ коммитить.

DOMAIN=example.duckdns.org
DUCKDNS_SUBDOMAIN=example
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

# Порт HTTPS на хосте (на роутере пробросьте на него внешний 443 TCP+UDP).
# Порт 80 не используется: сертификат выпускается через DNS-проверку DuckDNS.
HTTPS_PORT=443

TZ=Europe/Moscow
